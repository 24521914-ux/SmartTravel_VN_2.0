# Public settings only; VITE_* values are included in the browser bundle.
# Photon public demo: moderate, explicitly triggered lookups only; no API key.
# For production traffic, point this to your own Photon instance/provider.
VITE_PHOTON_URL=https://photon.komoot.io
# Default: Stadia Maps on localhost (no key), OSM on deployed domains.
# Override BOTH values together for a different tile provider; keep its required attribution.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>

# Development only: P02 captures email in Mailpit. Set empty when using real SMTP.
VITE_LOCAL_MAILBOX_URL=http://localhost:59025

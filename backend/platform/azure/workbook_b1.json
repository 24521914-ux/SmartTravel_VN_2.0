{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "# SmartTravel VN 2.0 — Operations, Resources & Cost Dashboard (Plan B1)\nTheo dõi trạng thái hoạt động, CPU/RAM/Requests, Logs/Cold-start và kiểm soát chi phí cho **7 Azure Container Apps** trong `rg-smarttravel-b1` (Consumption Scale-to-Zero, `0.25 vCPU / 0.5 GiB`)."
      },
      "name": "header"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "param-sub",
            "version": "KqlParameterItem/1.0",
            "name": "Subscription",
            "type": 6,
            "isRequired": true,
            "value": "value::1",
            "typeSettings": {
              "additionalResourceOptions": []
            }
          },
          {
            "id": "param-rg",
            "version": "KqlParameterItem/1.0",
            "name": "ResourceGroup",
            "label": "Resource Group",
            "type": 1,
            "isRequired": true,
            "value": "rg-smarttravel-b1"
          },
          {
            "id": "param-timerange",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "label": "Khoảng thời gian",
            "type": 4,
            "isRequired": true,
            "value": {
              "durationMs": 86400000
            },
            "typeSettings": {
              "selectableValues": [
                { "durationMs": 3600000 },
                { "durationMs": 21600000 },
                { "durationMs": 86400000 },
                { "durationMs": 259200000 },
                { "durationMs": 604800000 },
                { "durationMs": 2592000000 }
              ]
            }
          },
          {
            "id": "param-apps",
            "version": "KqlParameterItem/1.0",
            "name": "ContainerApps",
            "label": "Services (Container Apps)",
            "type": 5,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "Resources\n| where type =~ 'microsoft.app/containerapps' and resourceGroup =~ '{ResourceGroup}'\n| project value = id, label = name, selected = true\n| order by label asc",
            "crossComponentResources": [
              "{Subscription}"
            ],
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources",
            "typeSettings": {
              "additionalResourceOptions": ["value::all"],
              "selectAllValue": "*"
            }
          },
          {
            "id": "param-law",
            "version": "KqlParameterItem/1.0",
            "name": "Workspace",
            "label": "Log Analytics Workspace",
            "type": 5,
            "isRequired": true,
            "query": "Resources\n| where type =~ 'microsoft.operationalinsights/workspaces' and resourceGroup =~ '{ResourceGroup}'\n| project value = id, label = name, selected = true",
            "crossComponentResources": [
              "{Subscription}"
            ],
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          }
        ],
        "style": "pills",
        "queryType": 0
      },
      "name": "global-parameters"
    },
    {
      "type": 11,
      "content": {
        "version": "LinkItem/1.0",
        "style": "tabs",
        "links": [
          {
            "id": "tab-overview",
            "cellValue": "SelectedTab",
            "linkTarget": "parameter",
            "linkLabel": "1. Trạng thái Services & Deploy",
            "subTarget": "overview",
            "style": "link"
          },
          {
            "id": "tab-resources",
            "cellValue": "SelectedTab",
            "linkTarget": "parameter",
            "linkLabel": "2. CPU, RAM, Requests & Latency",
            "subTarget": "resources",
            "style": "link"
          },
          {
            "id": "tab-logs",
            "cellValue": "SelectedTab",
            "linkTarget": "parameter",
            "linkLabel": "3. Logs lỗi & KEDA Scale Events",
            "subTarget": "logs",
            "style": "link"
          },
          {
            "id": "tab-cost",
            "cellValue": "SelectedTab",
            "linkTarget": "parameter",
            "linkLabel": "4. Credit Azure & Free Grant",
            "subTarget": "cost",
            "style": "link"
          }
        ]
      },
      "name": "navigation-tabs"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "Resources\n| where type =~ 'microsoft.app/containerapps' and resourceGroup =~ '{ResourceGroup}'\n| extend container = properties.template.containers[0]\n| extend scale = properties.template.scale\n| extend ingress = properties.configuration.ingress\n| project\n    Service = name,\n    LatestRevision = tostring(properties.latestRevisionName),\n    ReadyRevision = tostring(properties.latestReadyRevisionName),\n    Image = tostring(container.image),\n    CPU = todouble(container.resources.cpu),\n    Memory = tostring(container.resources.memory),\n    ScaleRange = strcat(tostring(scale.minReplicas), ' - ', tostring(scale.maxReplicas)),\n    Ingress = iff(tobool(ingress.external), 'External HTTPS', 'Internal Mesh'),\n    State = tostring(properties.runningStatus)\n| order by Service asc",
              "size": 1,
              "title": "Danh sách 7 Microservices & Bản Deploy mới nhất",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "table"
            },
            "name": "services-inventory"
          },
          {
            "type": 10,
            "content": {
              "chartId": "workbook-replicas",
              "version": "MetricsItem/2.0",
              "size": 0,
              "chartType": 2,
              "resourceType": "microsoft.app/containerapps",
              "metricScope": 0,
              "resourceIds": [
                "{ContainerApps}"
              ],
              "timeContextFromParameter": "TimeRange",
              "metrics": [
                {
                  "namespace": "microsoft.app/containerapps",
                  "metric": "microsoft.app/containerapps--Replicas",
                  "aggregation": 3,
                  "splitBy": null
                }
              ],
              "title": "Số Replica đang chạy (0 = Đang ngủ Scale-to-Zero, >=1 = Đang thức)",
              "gridSettings": {
                "rowLimit": 100
              }
            },
            "name": "replicas-chart"
          },
          {
            "type": 10,
            "content": {
              "chartId": "workbook-restarts",
              "version": "MetricsItem/2.0",
              "size": 0,
              "chartType": 2,
              "resourceType": "microsoft.app/containerapps",
              "metricScope": 0,
              "resourceIds": [
                "{ContainerApps}"
              ],
              "timeContextFromParameter": "TimeRange",
              "metrics": [
                {
                  "namespace": "microsoft.app/containerapps",
                  "metric": "microsoft.app/containerapps--RestartCount",
                  "aggregation": 3,
                  "splitBy": null
                }
              ],
              "title": "Số lần Restart Container (Cảnh báo OOMKill / Crash nếu > 0)"
            },
            "name": "restarts-chart"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "overview"
      },
      "name": "group-overview"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {

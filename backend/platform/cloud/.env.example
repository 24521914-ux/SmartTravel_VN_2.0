# Cloud stack settings. Copy is created by `python backend/platform/cloud/manage.py init`.
# NEVER commit, screenshot or paste the real backend/platform/cloud/.env anywhere.

# ===== 1. Internal secrets: generated by manage.py init (prepare()) =====================================
# Leave as GENERATED_BY_MANAGE_INIT: prepare() replaces only these placeholders (or empty values) with
# random values and never overwrites a value that is already set. Changing a broker password after the
# RabbitMQ volume exists does not change the stored user; Identity keeps its signing key in a volume.
BROKER_ADMIN_PASSWORD=GENERATED_BY_MANAGE_INIT
IDENTITY_BROKER_PASSWORD=GENERATED_BY_MANAGE_INIT
CATALOG_BROKER_PASSWORD=GENERATED_BY_MANAGE_INIT
COMMUNITY_BROKER_PASSWORD=GENERATED_BY_MANAGE_INIT
TRIP_BROKER_PASSWORD=GENERATED_BY_MANAGE_INIT
INGESTION_BROKER_PASSWORD=GENERATED_BY_MANAGE_INIT
INTELLIGENCE_BROKER_PASSWORD=GENERATED_BY_MANAGE_INIT
CATALOG_BROKER_OPERATOR_PASSWORD=GENERATED_BY_MANAGE_INIT
# Gateway -> Identity token exchange, and per-service client-credentials secrets (>= 32 chars).
GATEWAY_EXCHANGE_SECRET=GENERATED_BY_MANAGE_INIT
CATALOG_WORKLOAD_SECRET=GENERATED_BY_MANAGE_INIT
COMMUNITY_WORKLOAD_SECRET=GENERATED_BY_MANAGE_INIT
TRIP_WORKLOAD_SECRET=GENERATED_BY_MANAGE_INIT
INGESTION_WORKLOAD_SECRET=GENERATED_BY_MANAGE_INIT
INTELLIGENCE_WORKLOAD_SECRET=GENERATED_BY_MANAGE_INIT
CATALOG_CURSOR_KEY=GENERATED_BY_MANAGE_INIT
IDENTITY_MAIL_KEY=GENERATED_BY_MANAGE_INIT
IDENTITY_FIXTURE_PASSWORD=GENERATED_BY_MANAGE_INIT

# ===== 2. Managed databases: fill from Neon and MongoDB Atlas; prepare() never writes these ===========
# Neon: DIRECT endpoint (not -pooler), one database per service, JDBC URL without credentials.
# Keep sslmode=verify-full (TLS + certificate/hostname check); sslrootcert is the Linux container CA bundle.
# Role names are fixed by the Flyway migrations: <service>_runtime (app) and <service>_migrator (DDL).
# Quote passwords with single quotes to preserve $, # and spaces.
NEON_IDENTITY_DB_URL=jdbc:postgresql://YOUR_IDENTITY_HOST.neon.tech:5432/identity_db?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
NEON_IDENTITY_RUNTIME_PASSWORD='YOUR_IDENTITY_RUNTIME_PASSWORD'
NEON_IDENTITY_MIGRATION_PASSWORD='YOUR_IDENTITY_MIGRATION_PASSWORD'
# catalog_db needs: CREATE EXTENSION postgis;
NEON_CATALOG_DB_URL=jdbc:postgresql://YOUR_CATALOG_HOST.neon.tech:5432/catalog_db?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
NEON_CATALOG_RUNTIME_PASSWORD='YOUR_CATALOG_RUNTIME_PASSWORD'
NEON_CATALOG_MIGRATION_PASSWORD='YOUR_CATALOG_MIGRATION_PASSWORD'
NEON_TRIP_DB_URL=jdbc:postgresql://YOUR_TRIP_HOST.neon.tech:5432/trip_db?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
NEON_TRIP_RUNTIME_PASSWORD='YOUR_TRIP_RUNTIME_PASSWORD'
NEON_TRIP_MIGRATION_PASSWORD='YOUR_TRIP_MIGRATION_PASSWORD'
NEON_INGESTION_DB_URL=jdbc:postgresql://YOUR_INGESTION_HOST.neon.tech:5432/ingestion_db?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
NEON_INGESTION_RUNTIME_PASSWORD='YOUR_INGESTION_RUNTIME_PASSWORD'
NEON_INGESTION_MIGRATION_PASSWORD='YOUR_INGESTION_MIGRATION_PASSWORD'
# intelligence_db needs: CREATE EXTENSION vector;
NEON_INTELLIGENCE_DB_URL=jdbc:postgresql://YOUR_INTELLIGENCE_HOST.neon.tech:5432/intelligence_db?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
NEON_INTELLIGENCE_RUNTIME_PASSWORD='YOUR_INTELLIGENCE_RUNTIME_PASSWORD'
NEON_INTELLIGENCE_MIGRATION_PASSWORD='YOUR_INTELLIGENCE_MIGRATION_PASSWORD'
# Atlas: SRV URIs with the database in the path; URL-encode passwords. Two Database Users:
#   community_runtime  -> custom role (find/insert/update/remove on community_db collections)
#   community_migrator -> dbAdmin + readWrite on community_db (schema migrations only)
ATLAS_MONGODB_URI='mongodb+srv://community_runtime:YOUR_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/community_db?retryWrites=true&w=majority&authSource=admin'
ATLAS_MONGODB_MIGRATION_URI='mongodb+srv://community_migrator:YOUR_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/community_db?retryWrites=true&w=majority&authSource=admin'

# ===== 3. Optional runtime settings ==================================================================
# Public entry point (Gateway only). Use 0.0.0.0:443 etc. only behind a TLS terminator/reverse proxy.
GATEWAY_PUBLISH=127.0.0.1:58080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_ENABLED=false
IDENTITY_SESSION_CACHE_SECONDS=15
# Synthetic demo accounts (fixture-*@example.invalid, password IDENTITY_FIXTURE_PASSWORD).
IDENTITY_FIXTURES_ENABLED=false
CONNECTOR_ALLOWED_HOSTS=none.invalid
# External SMTP (replaces the local Mailpit sandbox). E-mail stays off until configured.
IDENTITY_NOTIFICATION_EMAIL_ENABLED=false
IDENTITY_MAIL_FROM=no-reply@smarttravel.invalid
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Copy to .env here. NEVER commit or share the real file.
# Neon: use DIRECT endpoint (not -pooler) and separate database/user per service.
# JDBC URL, NOT postgres://; no username/password in URL.
# sslrootcert below uses the Linux container CA bundle, NOT a Windows path.
# Quote passwords with single quotes to preserve $, # and spaces in Compose.
IDENTITY_DB_URL=jdbc:postgresql://YOUR_IDENTITY_HOST.neon.tech:5432/identity_db?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
IDENTITY_DB_USER=YOUR_IDENTITY_USER
IDENTITY_DB_PASSWORD='YOUR_IDENTITY_PASSWORD'
CATALOG_DB_URL=jdbc:postgresql://YOUR_CATALOG_HOST.neon.tech:5432/catalog_db?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
CATALOG_DB_USER=YOUR_CATALOG_USER
CATALOG_DB_PASSWORD='YOUR_CATALOG_PASSWORD'
TRIP_DB_URL=jdbc:postgresql://YOUR_TRIP_HOST.neon.tech:5432/trip_db?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
TRIP_DB_USER=YOUR_TRIP_USER
TRIP_DB_PASSWORD='YOUR_TRIP_PASSWORD'
INGESTION_DB_URL=jdbc:postgresql://YOUR_INGESTION_HOST.neon.tech:5432/ingestion_db?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
INGESTION_DB_USER=YOUR_INGESTION_USER
INGESTION_DB_PASSWORD='YOUR_INGESTION_PASSWORD'
INTELLIGENCE_DB_URL=jdbc:postgresql://YOUR_INTELLIGENCE_HOST.neon.tech:5432/intelligence_db?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
INTELLIGENCE_DB_USER=YOUR_INTELLIGENCE_USER
INTELLIGENCE_DB_PASSWORD='YOUR_INTELLIGENCE_PASSWORD'
# Atlas Database User password must be URL-encoded. Keep database in path.
MONGODB_URI='mongodb+srv://YOUR_USER:YOUR_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/community_db?retryWrites=true&w=majority'
# Defaults below are TEST ONLY. Override both for a real JWT provider.
JWT_JWKS_URI=http://dev-issuer:18083/jwks
JWT_ISSUER=local-test

{
  "openapi": "3.1.0",
  "info": {
    "title": "SmartTravel automatic day travel legs additive extension",
    "version": "1.0.0",
    "description": "Derived same-day itinerary adjacency owned by Trip service; legacy destinations/transfers remain unchanged. Route computation does not increment trip version. PATCH also retries a failed/fallback calculation when submitted with the same mode. SELF_MANAGED clears estimates; FALLBACK distance is straight-line and duration is null."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/trips/{trip}/days/{day}/travel-legs": {
      "get": {
        "operationId": "listDayTravelLegs",
        "parameters": [
          {
            "name": "trip",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "day",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Persisted current state. A saved itinerary may still have PENDING route calculations.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "next_cursor",
                    "as_of",
                    "watermark"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DayTravelLeg"
                      }
                    },
                    "next_cursor": {
                      "type": "null"
                    },
                    "as_of": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "watermark": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "trip:read scope required"
          },
          "404": {
            "description": "Trip/day not owned or not found"
          }
        }
      }
    },
    "/api/v1/trips/{trip}/days/{day}/travel-legs/{leg}": {
      "patch": {
        "operationId": "changeDayTravelLegMode",
        "parameters": [
          {
            "name": "trip",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "day",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "leg",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\"[1-9][0-9]*\"$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "mode"
                ],
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "DRIVE",
                      "WALK",
                      "BICYCLE",
                      "SELF_MANAGED"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Persisted current state. A saved itinerary may still have PENDING route calculations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DayTravelLeg"
                }
              }
            }
          },
          "400": {
            "description": "Invalid mode or body"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "trip:write scope required"
          },
          "404": {
            "description": "Trip/day/leg not owned or not found"
          },
          "409": {
            "description": "VERSION_CONFLICT; refresh and reconcile before retry"
          },
          "428": {
            "description": "If-Match required"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "DayTravelLeg": {
        "type": "object",
        "required": [
          "leg_id",
          "day_id",
          "from_item_id",
          "to_item_id",
          "mode",
          "status",
          "distance_m",
          "duration_seconds",
          "fallback",
          "geometry",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "leg_id": {
            "type": "string",
            "format": "uuid"
          },
          "day_id": {
            "type": "string",
            "format": "uuid"
          },
          "from_item_id": {
            "type": "string",
            "format": "uuid"
          },
          "to_item_id": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "type": "string",
            "enum": [
              "DRIVE",
              "WALK",
              "BICYCLE",
              "SELF_MANAGED"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "READY",
              "FALLBACK",
              "FAILED",
              "SELF_MANAGED"
            ]
          },
          "distance_m": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "duration_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "fallback": {
            "type": "boolean"
          },
          "geometry": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "coordinates"
                ],
                "properties": {
                  "type": {
                    "const": "LineString"
                  },
                  "coordinates": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 10000,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "prefixItems": [
                        {
                          "type": "number",
                          "minimum": -180,
                          "maximum": 180
                        },
                        {
                          "type": "number",
                          "minimum": -90,
                          "maximum": 90
                        }
                      ]
                    }
                  }
                }
              }
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}

{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "community.review.changed.v1"
    },
    "schema_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "review"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "community"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "review_id": {
          "type": "string",
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "place_id": {
          "type": "string",
          "format": "uuid"
        },
        "previous_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "PENDING",
            "APPROVED",
            "REJECTED",
            "HIDDEN",
            "DELETED"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED",
            "HIDDEN",
            "DELETED"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "change_kind": {
          "type": "string",
          "enum": [
            "CREATED",
            "UPDATED",
            "MODERATED",
            "DELETED"
          ]
        }
      },
      "required": [
        "review_id",
        "user_id",
        "place_id",
        "previous_status",
        "status",
        "version",
        "change_kind"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "occurred_at",
    "producer",
    "correlation_id",
    "causation_id",
    "traceparent",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "ingestion.source-policy.changed.v1"
    },
    "schema_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "source"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "ingestion"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_version": {
          "type": "integer",
          "minimum": 1
        },
        "license_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "allow_storage": {
          "type": "boolean"
        },
        "allow_training": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "PERMITTED",
            "REVOKED"
          ]
        }
      },
      "required": [
        "source_id",
        "source_version",
        "license_version",
        "allow_storage",
        "allow_training",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "occurred_at",
    "producer",
    "correlation_id",
    "causation_id",
    "traceparent",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "ingestion.place.upsert-requested.v1"
    },
    "schema_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "import"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "ingestion"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "external_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "source_version": {
          "type": "integer",
          "minimum": 1
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "proposed_place_id": {
          "type": "string",
          "format": "uuid"
        },
        "normalized": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "category_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "maxItems": 100
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "opening_hours": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "weekday": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 6
                  },
                  "open": {
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                  },
                  "close": {
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                  },
                  "overnight": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "weekday",
                  "open",
                  "close",
                  "overnight"
                ],
                "additionalProperties": false
              },
              "maxItems": 28
            },
            "price": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "enum": [
                "VND"
              ]
            }
          },
          "required": [],
          "additionalProperties": false,
          "minProperties": 1
        },
        "expected_catalog_version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "command_id",
        "source_id",
        "external_id",
        "source_version",
        "source_hash",
        "proposed_place_id",
        "normalized",
        "expected_catalog_version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "occurred_at",
    "producer",
    "correlation_id",
    "causation_id",
    "traceparent",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

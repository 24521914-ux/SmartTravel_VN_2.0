{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "domain.user-data-deleted.v1"
    },
    "schema_version": {
      "const": 1
    },
    "aggregate_type": {
      "const": "deletion"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "enum": [
        "catalog",
        "community",
        "trip",
        "ingestion",
        "intelligence"
      ]
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "deletion_request_id": {
          "type": "string",
          "format": "uuid"
        },
        "service": {
          "type": "string",
          "enum": [
            "catalog",
            "community",
            "trip",
            "ingestion",
            "intelligence"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "COMPLETED",
            "FAILED"
          ]
        },
        "artifact_handling": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "deletion_request_id",
        "service",
        "status",
        "artifact_handling"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "occurred_at",
    "producer",
    "correlation_id",
    "causation_id",
    "traceparent",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

# Local stack settings (docker-compose.yml + docker-compose.override.yml).
#   python backend/platform/init_env.py      # copies this file to .env and generates every secret
#   docker compose up -d --build --wait
# The real .env is Git-ignored: never commit, screenshot or paste it. Values left as
# GENERATED_BY_INIT_ENV are replaced with random values; existing values are never overwritten.
# Changing a database/broker password after its volume exists does not change the stored password.

# ===== Settings ======================================================================================
# Gateway AI routes are deferred unless true (the backend integration smoke needs true).
AI_ENABLED=false
IDENTITY_SESSION_CACHE_SECONDS=15
# Synthetic demo accounts fixture-*@example.invalid (local default: on).
IDENTITY_FIXTURES_ENABLED=true

# ===== Internal secrets (generated) ==================================================================
BROKER_ADMIN_PASSWORD=GENERATED_BY_INIT_ENV
IDENTITY_BROKER_PASSWORD=GENERATED_BY_INIT_ENV
CATALOG_BROKER_PASSWORD=GENERATED_BY_INIT_ENV
COMMUNITY_BROKER_PASSWORD=GENERATED_BY_INIT_ENV
TRIP_BROKER_PASSWORD=GENERATED_BY_INIT_ENV
INGESTION_BROKER_PASSWORD=GENERATED_BY_INIT_ENV
INTELLIGENCE_BROKER_PASSWORD=GENERATED_BY_INIT_ENV
CATALOG_BROKER_OPERATOR_PASSWORD=GENERATED_BY_INIT_ENV
# Gateway -> Identity token exchange, and per-service client-credentials secrets (>= 32 chars).
GATEWAY_EXCHANGE_SECRET=GENERATED_BY_INIT_ENV
CATALOG_WORKLOAD_SECRET=GENERATED_BY_INIT_ENV
COMMUNITY_WORKLOAD_SECRET=GENERATED_BY_INIT_ENV
TRIP_WORKLOAD_SECRET=GENERATED_BY_INIT_ENV
INGESTION_WORKLOAD_SECRET=GENERATED_BY_INIT_ENV
INTELLIGENCE_WORKLOAD_SECRET=GENERATED_BY_INIT_ENV
CATALOG_CURSOR_KEY=GENERATED_BY_INIT_ENV
IDENTITY_MAIL_KEY=GENERATED_BY_INIT_ENV
IDENTITY_FIXTURE_PASSWORD=GENERATED_BY_INIT_ENV

# ===== Local databases (containers of docker-compose.override.yml) ===================================
# ADMIN = database superuser (local only); MIGRATION/RUNTIME = the <service>_migrator/_runtime roles.
IDENTITY_DB_URL=jdbc:postgresql://identity-db:5432/identity_db
IDENTITY_ADMIN_PASSWORD=GENERATED_BY_INIT_ENV
IDENTITY_MIGRATION_PASSWORD=GENERATED_BY_INIT_ENV
IDENTITY_RUNTIME_PASSWORD=GENERATED_BY_INIT_ENV
CATALOG_DB_URL=jdbc:postgresql://catalog-db:5432/catalog_db
CATALOG_ADMIN_PASSWORD=GENERATED_BY_INIT_ENV
CATALOG_MIGRATION_PASSWORD=GENERATED_BY_INIT_ENV
CATALOG_RUNTIME_PASSWORD=GENERATED_BY_INIT_ENV
TRIP_DB_URL=jdbc:postgresql://trip-db:5432/trip_db
TRIP_ADMIN_PASSWORD=GENERATED_BY_INIT_ENV
TRIP_MIGRATION_PASSWORD=GENERATED_BY_INIT_ENV
TRIP_RUNTIME_PASSWORD=GENERATED_BY_INIT_ENV
INGESTION_DB_URL=jdbc:postgresql://ingestion-db:5432/ingestion_db
INGESTION_ADMIN_PASSWORD=GENERATED_BY_INIT_ENV
INGESTION_MIGRATION_PASSWORD=GENERATED_BY_INIT_ENV
INGESTION_RUNTIME_PASSWORD=GENERATED_BY_INIT_ENV
INTELLIGENCE_DB_URL=jdbc:postgresql://intelligence-db:5432/intelligence_db
INTELLIGENCE_ADMIN_PASSWORD=GENERATED_BY_INIT_ENV
INTELLIGENCE_MIGRATION_PASSWORD=GENERATED_BY_INIT_ENV
INTELLIGENCE_RUNTIME_PASSWORD=GENERATED_BY_INIT_ENV
# MongoDB replica set: URIs are derived from the community passwords by init_env.py.
COMMUNITY_ADMIN_PASSWORD=GENERATED_BY_INIT_ENV
COMMUNITY_MIGRATION_PASSWORD=GENERATED_BY_INIT_ENV
COMMUNITY_RUNTIME_PASSWORD=GENERATED_BY_INIT_ENV
COMMUNITY_MONGODB_URI=GENERATED_BY_INIT_ENV
COMMUNITY_MONGODB_MIGRATION_URI=GENERATED_BY_INIT_ENV

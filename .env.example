# Local-only defaults for `cp .env.example .env && docker compose up -d --build`.
# These values are public: never use them outside a loopback developer machine.
# Prefer random secrets:  py -3 backend/infra/p02.py env   (writes .env and keeps backend/infra/.local/p02/secrets.json in sync)
# Changing a database/broker password after its volume exists does not change the stored password.

# Gateway: AI routes are deferred by default (true only to exercise the recommendation backend).
AI_ENABLED=false

# Platform
BROKER_ADMIN_PASSWORD=local-only-broker-admin-password-change-me
GATEWAY_EXCHANGE_SECRET=local-only-gateway-exchange-secret-change-me
IDENTITY_FIXTURE_PASSWORD=local-only-identity-fixture-password-change-me
IDENTITY_MAIL_KEY=bG9jYWwtb25seS1tYWlsLWtleS1jaGFuZ2UtbWUtMzI=
CATALOG_CURSOR_KEY=local-only-catalog-cursor-key-change-me
CATALOG_BROKER_OPERATOR_PASSWORD=local-only-catalog-broker-operator-password-change-me

# Identity
IDENTITY_ADMIN_PASSWORD=local-only-identity-admin-password-change-me
IDENTITY_MIGRATION_PASSWORD=local-only-identity-migration-password-change-me
IDENTITY_RUNTIME_PASSWORD=local-only-identity-runtime-password-change-me
IDENTITY_BROKER_PASSWORD=local-only-identity-broker-password-change-me


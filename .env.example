# Default stack: PostgreSQL on Neon, MongoDB on Atlas; no local database containers.
#   python backend/platform/init_env.py   # copies this file to .env, generates group 1
#   (fill group 2 in .env yourself)
#   python backend/platform/cloud/manage.py up         # validate, preflight, build, start, wait
# The real .env is Git-ignored: never commit, screenshot or paste it.

# Separate Compose project: the local stack (smarttravel-p02) and its volumes stay untouched.
COMPOSE_PROJECT_NAME=smarttravel-cloud

# ===== 1. Internal secrets: generated by init_env.py ================================================
# GENERATED_BY_INIT_ENV (or empty) values are replaced with random values; set values are kept.
BROKER_ADMIN_PASSWORD=GENERATED_BY_INIT_ENV
IDENTITY_BROKER_PASSWORD=GENERATED_BY_INIT_ENV
CATALOG_BROKER_PASSWORD=GENERATED_BY_INIT_ENV
COMMUNITY_BROKER_PASSWORD=GENERATED_BY_INIT_ENV
TRIP_BROKER_PASSWORD=GENERATED_BY_INIT_ENV
INGESTION_BROKER_PASSWORD=GENERATED_BY_INIT_ENV
INTELLIGENCE_BROKER_PASSWORD=GENERATED_BY_INIT_ENV
CATALOG_BROKER_OPERATOR_PASSWORD=GENERATED_BY_INIT_ENV
GATEWAY_EXCHANGE_SECRET=GENERATED_BY_INIT_ENV
CATALOG_WORKLOAD_SECRET=GENERATED_BY_INIT_ENV
COMMUNITY_WORKLOAD_SECRET=GENERATED_BY_INIT_ENV
TRIP_WORKLOAD_SECRET=GENERATED_BY_INIT_ENV
INGESTION_WORKLOAD_SECRET=GENERATED_BY_INIT_ENV
INTELLIGENCE_WORKLOAD_SECRET=GENERATED_BY_INIT_ENV
CATALOG_CURSOR_KEY=GENERATED_BY_INIT_ENV
IDENTITY_MAIL_KEY=GENERATED_BY_INIT_ENV
IDENTITY_FIXTURE_PASSWORD=GENERATED_BY_INIT_ENV

# ===== 2. Managed databases: fill from Neon and MongoDB Atlas; init_env.py never writes these ========
# Neon: DIRECT endpoint (not -pooler), one database per service, JDBC URL without credentials.
# Keep sslmode=verify-full (TLS + certificate/hostname check); sslrootcert is the Linux container CA bundle.
# Role names are fixed by the Flyway migrations: <service>_runtime (app) and <service>_migrator (DDL).
# Quote passwords with single quotes to preserve $, # and spaces.
IDENTITY_DB_URL=jdbc:postgresql://YOUR_IDENTITY_HOST.neon.tech:5432/identity_db?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
IDENTITY_RUNTIME_PASSWORD='YOUR_IDENTITY_RUNTIME_PASSWORD'
IDENTITY_MIGRATION_PASSWORD='YOUR_IDENTITY_MIGRATION_PASSWORD'
# catalog_db needs: CREATE EXTENSION postgis;
CATALOG_DB_URL=jdbc:postgresql://YOUR_CATALOG_HOST.neon.tech:5432/catalog_db?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
CATALOG_RUNTIME_PASSWORD='YOUR_CATALOG_RUNTIME_PASSWORD'
CATALOG_MIGRATION_PASSWORD='YOUR_CATALOG_MIGRATION_PASSWORD'
TRIP_DB_URL=jdbc:postgresql://YOUR_TRIP_HOST.neon.tech:5432/trip_db?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
TRIP_RUNTIME_PASSWORD='YOUR_TRIP_RUNTIME_PASSWORD'
TRIP_MIGRATION_PASSWORD='YOUR_TRIP_MIGRATION_PASSWORD'
INGESTION_DB_URL=jdbc:postgresql://YOUR_INGESTION_HOST.neon.tech:5432/ingestion_db?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
INGESTION_RUNTIME_PASSWORD='YOUR_INGESTION_RUNTIME_PASSWORD'
INGESTION_MIGRATION_PASSWORD='YOUR_INGESTION_MIGRATION_PASSWORD'
# intelligence_db needs: CREATE EXTENSION vector;
INTELLIGENCE_DB_URL=jdbc:postgresql://YOUR_INTELLIGENCE_HOST.neon.tech:5432/intelligence_db?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
INTELLIGENCE_RUNTIME_PASSWORD='YOUR_INTELLIGENCE_RUNTIME_PASSWORD'
INTELLIGENCE_MIGRATION_PASSWORD='YOUR_INTELLIGENCE_MIGRATION_PASSWORD'
# Atlas: SRV URIs with the database in the path; URL-encode passwords. Two Database Users:
#   community_runtime  -> custom role (find/insert/update/remove on community_db collections)
#   community_migrator -> dbAdmin + readWrite on community_db (schema migrations only)
COMMUNITY_MONGODB_URI='mongodb+srv://community_runtime:YOUR_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/community_db?retryWrites=true&w=majority&authSource=admin'
COMMUNITY_MONGODB_MIGRATION_URI='mongodb+srv://community_migrator:YOUR_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/community_db?retryWrites=true&w=majority&authSource=admin'

# ===== 3. Optional runtime settings ==================================================================
# Public entry point (Gateway only). Use 0.0.0.0:443 etc. only behind a TLS terminator/reverse proxy.
GATEWAY_PUBLISH=127.0.0.1:58080
GATEWAY_RESPONSE_TIMEOUT=15s
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_ENABLED=false
IDENTITY_SESSION_CACHE_SECONDS=15
# Synthetic demo accounts (fixture-*@example.invalid, password IDENTITY_FIXTURE_PASSWORD).
IDENTITY_FIXTURES_ENABLED=false
CONNECTOR_ALLOWED_HOSTS=none.invalid
# External SMTP. E-mail stays off until configured.
IDENTITY_NOTIFICATION_EMAIL_ENABLED=false
IDENTITY_MAIL_FROM=no-reply@smarttravel.invalid
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
